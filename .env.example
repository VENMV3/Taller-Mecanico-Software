# Perfil local que inicia iniciar-taller.sh si no se indica otro.
SPRING_PROFILES_ACTIVE=dev

# Conexión local de desarrollo. Sustituye estos ejemplos por valores de tu entorno.
DB_URL=jdbc:mysql://localhost:3306/taller_dev?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=America/Mexico_City
DB_USER=taller_dev_user
DB_PASSWORD=example-local-db-password

# Cadena de al menos 32 caracteres, exclusiva para desarrollo local.
JWT_SECRET=example-local-jwt-signing-key-change-me-1234567890
DEV_TECHNICAL_ACCOUNT_PASSWORD=example-technical-account-password
